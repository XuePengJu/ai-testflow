# 阿里百炼 / 通义千问 API Key
# 留空则自动进入 mock 兜底模式（无需联网即可跑通全流程，适合演示）
DASHSCOPE_API_KEY=

# 使用的模型名（留空用默认 qwen-plus）
MODEL_NAME=qwen-plus

# ===== V2 认证 =====
# JWT 签名密钥（生产必改；默认占位值时启动仅 WARNING，ENV=production 时拒启）
JWT_SECRET=change-me-in-production
# 部署环境：dev / production
ENV=dev
# 迁移脚本预置 admin 密码（可留空=随机生成打印一次）
ADMIN_BOOTSTRAP=
